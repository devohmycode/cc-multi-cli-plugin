{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugins/multi/src/native-model-gateway.ts",
    "plugins/multi/src/gateway/permission-hook.ts",
    "plugins/multi/src/transports/{cursor,opencode}.mjs",
