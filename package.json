{
  "name": "cc-multi-cli-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin that offloads coding work to external CLIs (Codex, Cursor, OpenCode) to reduce Claude token usage.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test \"test/unit/**/*.test.mjs\" \"test/unit/**/*.test.ts\"",
    "test:live": "node plugins/multi/scripts/test/no-dep0190.mjs",
    "test:all": "npm test && npm run test:live",
    "build:acp-vendor": "node scripts/build-acp-vendor.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
